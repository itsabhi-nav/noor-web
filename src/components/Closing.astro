<section class="relative overflow-hidden" aria-label="Closing statement">
  <img
    src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?q=80&w=2000&auto=format&fit=crop"
    alt="Calm neutral living space with sculptural chair"
    loading="lazy"
    class="img-warm absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-ink/55" />
  <div class="relative mx-auto max-w-[1440px] px-5 md:px-10 py-20 md:py-44 text-center text-ivory">
    <p class="text-[11px] font-semibold uppercase tracking-mega text-ivory/70">Noor Chair · Delhi</p>
    <h2 class="mx-auto mt-5 max-w-4xl font-display text-5xl md:text-8xl font-light leading-[0.98]">
      Find your place.<br /><span class="italic">Find your seat.</span>
    </h2>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/shop" class="rounded-full bg-ivory px-8 py-4 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink transition hover:bg-oxblood hover:text-white">
        Shop all chairs
      </a>
      <a href="/contact" class="rounded-full border border-ivory/50 px-8 py-4 text-[12px] font-semibold uppercase tracking-[0.16em] text-ivory transition hover:bg-ivory/10">
        Talk to us
      </a>
