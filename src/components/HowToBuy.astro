---
/**
 * Visual 3-step buying guide for the shop page.
 * Icons + minimal words so first-time and low-literacy shoppers get it instantly.
 * Zero JavaScript — inline SVGs only.
 */
const steps = [
  {
    n: '1',
    title: 'Tap any chair photo',
    sub: 'See big pictures, price & details',
    icon: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>',
  },
  {
    n: '2',
    title: 'Tap Add to bag',
    sub: 'Your picks stay saved here',
    icon: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  },
  {
    n: '3',
    title: 'Send on WhatsApp',
    sub: 'We confirm stock & delivery',
    icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  },
];
---

<div class="mt-8 rounded-2xl border border-line bg-parchment/60 p-4 md:p-5" aria-label="How buying works">
  <p class="text-[11px] font-semibold uppercase tracking-mega text-smoke">Easy as 1 · 2 · 3</p>
  <ol class="mt-3 grid gap-3 sm:grid-cols-3 sm:gap-4">
    {steps.map((s) => (
      <li class="flex items-center gap-3.5 rounded-xl bg-ivory px-4 py-3.5">
        <span class="relative flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink text-ivory" aria-hidden="true">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
          <span class="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full bg-oxblood text-[11px] font-bold text-white">{s.n}</span>
        </span>
        <span>
          <span class="block text-[15px] font-semibold leading-tight">{s.title}</span>
          <span class="mt-0.5 block text-[13px] leading-snug text-smoke">{s.sub}</span>
        </span>
      </li>
    ))}
  </ol>
</div>
