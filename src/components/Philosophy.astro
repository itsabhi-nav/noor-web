---
/**
 * Slim philosophy statement — the whole brand POV in three lines.
 * Replaces the old 300vh sticky story: same soul, zero fatigue.
 * Zero JavaScript.
 */
---

<section class="mx-auto max-w-[1440px] px-5 md:px-10 pt-12 pb-6 md:pt-16 md:pb-8 text-center" aria-label="Our philosophy">
  <p class="text-[11px] font-semibold uppercase tracking-mega text-oxblood">Our philosophy</p>
  <p class="mx-auto mt-4 max-w-3xl font-display text-[1.65rem] md:text-4xl font-light leading-[1.15] text-balance">
    A great chair disappears beneath you — <span class="italic">we design for the feeling,</span> not the furniture.
  </p>
  <a
    href="/story"
    class="mt-6 inline-block border-b-2 border-ink pb-1 text-[12px] font-semibold uppercase tracking-[0.18em] transition hover:border-oxblood hover:text-oxblood"
  >
    Read our story →
  </a>
</section>
