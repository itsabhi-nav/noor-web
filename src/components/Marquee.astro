---
import { CATEGORIES } from '../data/products';
---

<div class="marquee-mask overflow-hidden border-y border-line bg-ivory py-4" aria-hidden="true">
  <div class="animate-marquee flex w-max items-center gap-8 pr-8">
    {[0, 1].map((half) => (
      <div class="flex items-center gap-8" key={half}>
        {CATEGORIES.map((c) => (
          <span class="flex items-center gap-8" key={`${half}-${c.slug}`}>
            <span class="whitespace-nowrap font-display text-xl md:text-2xl font-light italic text-ink/80">
              {c.name}
            </span>
            <svg width="11" height="11" viewBox="0 0 11 11" aria-hidden="true" class="shrink-0">
              <rect x="2.7" y="2.7" width="5.6" height="5.6" transform="rotate(45 5.5 5.5)" fill="#86281C" />
            </svg>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>
