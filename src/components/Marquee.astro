---
import { CATEGORIES } from '../data/products';

const items = CATEGORIES.flatMap((c) => [c.name, '✳']);
---

<div class="marquee-mask overflow-hidden border-y border-line bg-ivory py-4" aria-hidden="true">
  <div class="animate-marquee flex w-max items-center gap-8 pr-8">
    {[0, 1].map((half) => (
      <div class="flex items-center gap-8" key={half}>
        {items.map((t, i) => (
          <span
            key={`${half}-${i}`}
            class={t === '✳' ? 'text-oxblood text-lg' : 'whitespace-nowrap font-display text-xl md:text-2xl font-light italic text-ink/80'}
          >
            {t}
          </span>
        ))}
      </div>
    ))}
  </div>
</div>
