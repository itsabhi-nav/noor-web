---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-line/70 rounded-2xl border border-line bg-ivory">
  {items.map((f) => (
    <details class="group px-6 py-5 [&_summary::-webkit-details-marker]:hidden">
      <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-xl font-light marker:content-none">
        {f.q}
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line text-lg transition-all duration-300 group-open:rotate-45 group-open:bg-ink group-open:text-ivory" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-smoke">{f.a}</p>
    </details>
  ))}
</div>
