---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout
  title="Contact & enquiries — Noor Chair Delhi"
  description="Contact Noor Chair in Delhi for chair enquiries, office seating and bulk requirements. Send a WhatsApp enquiry with your shortlist."
>
  <div class="mx-auto max-w-[1440px] px-5 md:px-10 pt-28 md:pt-40 pb-20">
    <p class="text-[11px] font-semibold uppercase tracking-mega text-oxblood">Contact</p>
    <h1 class="mt-4 max-w-3xl font-display text-5xl md:text-7xl font-light leading-[0.98]">
      Let's find your seat.
    </h1>
    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <div class="rounded-2xl bg-ink text-ivory p-7 md:p-9">
          <h2 class="font-display text-2xl font-light">Noor Chair · Delhi, India</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-ivory/70">
            For product questions, stock checks and business seating requirements, WhatsApp is
            the fastest route. Share your shortlist or room size and we'll respond during
            business hours.
          </p>
          <ul class="mt-6 space-y-3 text-[15px]">
            <li class="flex justify-between border-b border-ivory/15 pb-3"><span class="text-ivory/60">Location</span><span>Delhi, India</span></li>
            <li class="flex justify-between border-b border-ivory/15 pb-3"><span class="text-ivory/60">Hours</span><span>Shared on enquiry</span></li>
            <li class="flex justify-between"><span class="text-ivory/60">Channel</span><span>WhatsApp click-to-chat</span></li>
          </ul>
          <p class="mt-6 text-[13px] leading-relaxed text-ivory/50">
            No phone number or address is published here yet — the owner will supply official
            contact details before launch.
          </p>
        </div>
        <div class="mt-4 rounded-2xl border border-line p-7">
          <h2 class="font-display text-2xl font-light">Buying for a business?</h2>
          <p class="mt-2 text-[15px] text-smoke">Offices, schools, clinics, studios — build your shortlist in the bag first, then send one enquiry.</p>
          <a href="/shop" class="mt-4 inline-block border-b-2 border-ink pb-0.5 text-[12px] font-semibold uppercase tracking-[0.16em] hover:border-oxblood hover:text-oxblood">Build a shortlist →</a>
        </div>
      </div>
      <ContactForm client:load />
    </div>
  </div>
</Layout>
