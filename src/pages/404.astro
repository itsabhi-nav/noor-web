---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Noor Chair" description="The page you asked for doesn't exist. Explore the Noor Chair collection instead.">
  <div class="mx-auto max-w-[1440px] px-5 md:px-10 pt-36 md:pt-48 pb-24 text-center">
    <p class="text-[11px] font-semibold uppercase tracking-mega text-oxblood">404</p>
    <h1 class="mx-auto mt-4 max-w-2xl font-display text-5xl md:text-7xl font-light leading-[0.98]">
      This seat is taken. <span class="italic">This page isn't.</span>
    </h1>
    <p class="mx-auto mt-5 max-w-md text-[15px] text-smoke">The link may have moved. Here are better places to sit:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-ink px-7 py-3.5 text-[12px] font-semibold uppercase tracking-[0.16em] text-ivory hover:bg-oxblood transition">Home</a>
      <a href="/shop" class="rounded-full border border-ink px-7 py-3.5 text-[12px] font-semibold uppercase tracking-[0.16em] hover:bg-ink hover:text-ivory transition">Shop all</a>
      <a href="/cart" class="rounded-full border border-ink px-7 py-3.5 text-[12px] font-semibold uppercase tracking-[0.16em] hover:bg-ink hover:text-ivory transition">Your bag</a>
    </div>
  </div>
</Layout>
