---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy — Noor Chair (placeholder)" description="Placeholder privacy note for the Noor Chair demo site.">
  <div class="mx-auto max-w-3xl px-5 pt-32 md:pt-40 pb-20">
    <h1 class="font-display text-5xl font-light">Privacy <span class="text-xl text-smoke">(placeholder)</span></h1>
    <p class="mt-5 text-[15px] leading-relaxed text-smoke">This demo site stores your bag locally in your own browser (localStorage) and never uploads it anywhere. Contact and enquiry forms open WhatsApp with a pre-filled message — nothing is sent until you press send, and nothing is saved to a database. A final privacy policy will be published before launch.</p>
    <a href="/" class="mt-6 inline-block border-b-2 border-ink pb-0.5 text-[12px] font-semibold uppercase tracking-[0.16em]">← Home</a>
  </div>
</Layout>
